{
  "manifest_version": 3,

  "name": "PromptShield AI",

  "description": "AI Privacy Firewall for ChatGPT, Gemini, Claude and other AI assistants.",

  "version": "1.0.0",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptShield AI"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://grok.com/*"
      ],

      "js": [
        "scripts/scanner.js",
        "scripts/risk.js",
        "scripts/masker.js",
        "scripts/prompt_injection.js",
        "scripts/jailbreak_detector.js",
        "scripts/safety_engine.js",
        "scripts/safe_send.js",
        "scripts/widget.js",
        "content.js"
      ],

      "run_at": "document_idle"
    }
  ]
}